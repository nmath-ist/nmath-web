# Copia este ficheiro para .env (uso local com `vercel dev`) e/ou define
# estas mesmas variáveis no dashboard do Vercel (Project Settings > Environment Variables).
# Nunca faças commit do ficheiro .env real (já está no .gitignore).

# Password para entrar em /admin
ADMIN_PASSWORD=gabriela

# Opcional mas recomendado: um segredo separado só para assinar a sessão de login.
# Se não definires, é usada a própria ADMIN_PASSWORD.
ADMIN_SESSION_SECRET=

# Dados do projeto Supabase (Project Settings > API no dashboard do Supabase)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=coloca_aqui_a_service_role_key
